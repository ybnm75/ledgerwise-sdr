# Required for persistent production data. Turso/LibSQL works locally and on Vercel.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Free-tier research and reply model. Paid billing must remain disabled for this case study.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_MS=0
FIRECRAWL_API_KEY=
RESEARCH_CANDIDATE_OFFSET=0
RESEARCH_SCRAPY_ENABLED=1
RESEARCH_MAX_SCRAPY_PAGES=8
RESEARCH_PYTHON_BIN=python

# Optional free LangSmith Developer observability. Keep workspace trace limit at 4,500.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerwise-evaluation
LANGSMITH_TRACING=false

# Required to send a human-approved email. The sender must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Ledgerwise <sales@example.com>
TEST_RECIPIENT_EMAIL=

# Required for free Google Calendar availability and booking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=Africa/Algiers

# Required in production. Use a unique reviewer password and a random 32+ character signing secret.
APP_PASSWORD=
AUTH_SECRET=
