# Required for persistent production data. Turso/LibSQL works locally and on Vercel.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Required for live AI drafting and reply classification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# Required to send a human-approved email. The sender must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Ledgerwise <sales@example.com>

# Required for real availability and bookings.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=

# Optional: protect the deployed demo with a shared login.
APP_PASSWORD=
AUTH_SECRET=
