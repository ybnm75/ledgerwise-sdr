{
  "name": "ledgerwise-sdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "research": "node --env-file-if-exists=.env.local scripts/research.mjs",
    "benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/benchmark.ts",
    "benchmark:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/benchmark.ts --smoke",
    "ui:smoke": "node --env-file-if-exists=.env.local scripts/ui-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@libsql/client": "latest",
    "langsmith": "^0.13.1",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "latest"
  }
}
